# Application
APP_NAME=Employee Onboarding Automation Portal
APP_ENV=development
DEBUG=True

# Server
API_PREFIX=/api

# PostgreSQL connection (SQLAlchemy)
# Replace YOUR_PASSWORD with your local PostgreSQL password.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5433/employee_onboarding

# CORS (React Vite default)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
